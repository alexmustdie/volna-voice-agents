# --- Секреты (обязательны для реального режима, для FAKE_CALLS=true можно оставить пустыми) ---
SESSION_SECRET=                 # подписывает cookie панели и токены медиа-сокетов; при FAKE_CALLS=false не короче 16 символов (python -c "import secrets; print(secrets.token_hex(32))")
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=            # арендованный номер в E.164, например +12025550123

# --- Docker (docker-compose.prod.yml) ---
PANEL_BIND=127.0.0.1:8011        # адрес публикации панели на хосте; наружу её отдаёт reverse proxy

# --- База данных ---
# в docker-compose переопределяется на postgres-сервис
DATABASE_URL=postgresql+asyncpg://volna:volna@localhost:5432/volna
POSTGRES_USER=volna
POSTGRES_PASSWORD=volna
POSTGRES_DB=volna

# --- Режим работы ---
FAKE_CALLS=true                 # true: звонки и голосовая модель симулируются, внешние API не вызываются. Без переменной режим реальный (false)
PUBLIC_BASE_URL=http://localhost:8000   # публичный https-URL приложения (ngrok/домен), нужен Twilio для вебхуков
WORKER_ENABLED=true             # запускать воркер обзвона внутри процесса приложения

# --- Голосовой движок ---
VOICE_ENGINE=openai             # openai: GPT-Live-1 (акцент в русском); yandex: Yandex AI Studio Realtime (родной русский)
YANDEX_API_KEY=                 # AI Studio -> "Создать API-ключ" (aistudio.yandex.ru)
YANDEX_FOLDER_ID=               # идентификатор каталога Yandex Cloud (виден в консоли AI Studio)
YANDEX_REALTIME_MODEL=speech-realtime-260528
POST_CALL_ANALYSIS=true         # после звонка текстовая модель извлекает встречу, итог и "не звонить" из транскрипта
ANALYSIS_YANDEX_MODEL=yandexgpt/latest

# --- Модели OpenAI ---
LIVE_MODEL=gpt-live-1
BACKEND_MODEL=gpt-5.6-luna      # недорогая модель для рассуждений/инструментов (альтернатива: gpt-5.6-terra)
OPENAI_LIVE_WS_URL=wss://api.openai.com/v1/live/sessions

DISPLAY_TIMEZONE=Europe/Moscow    # в какой таймзоне панель показывает время
BARGE_IN_CLEAR_SECONDS=1.2        # сколько незаигранного звука терпим, прежде чем сбросить очередь при перебивании

# --- Внешний сервис офферов (HTTP API, GET /utp/match) ---
# Пусто -> волна работает без УТП и в сеть за офферами не ходит.
OFFERS_URL=                         # например http://offers:8010
OFFERS_TIMEOUT_SECONDS=0.4          # запрос во время разговора: пауза слышна
OFFERS_PREFETCH_TIMEOUT_SECONDS=2.0 # запрос до набора номера

# --- Обзвон ---
# Суточный лимит звонков с одного нашего номера: у площадок объявлений свои ограничения. 0 = без лимита.
DAILY_CALLS_PER_NUMBER=0
MIN_SECONDS_BETWEEN_CALLS=0     # пауза между звонками с одного номера, секунды

MAX_RETRIES=2                   # повторов после недозвона
RETRY_INTERVAL_SECONDS=900      # интервал между попытками
CALL_TIMEOUT_SECONDS=1800       # максимальная длительность одного звонка
RINGING_TIMEOUT_SECONDS=120     # сколько ждать ответа до пометки no_answer
WORKER_POLL_SECONDS=5

# --- Мок-режим ---
FAKE_ANSWER_RATE=0.7            # доля дозвонов
FAKE_MEETING_RATE=0.4           # доля отвеченных звонков с назначенной встречей
FAKE_CALL_SECONDS=6             # длительность симулированного разговора в реальных секундах

# --- Twilio ---
TWILIO_VALIDATE_SIGNATURE=true  # проверять подпись вебхуков Twilio
